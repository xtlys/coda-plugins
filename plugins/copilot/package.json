{
  "name": "copilot",
  "displayName": "GitHub Copilot",
  "description": "GitHub Copilot Agent：通过运行机上 Copilot CLI 的原生 ACP 接入，每个会话一个进程。",
  "version": "1.0.0",
  "contributes": {
    "agents": [
      {
        "id": "copilot",
        "displayName": "GitHub Copilot",
        "icon": {
          "light": "icons/copilot.pdf",
          "template": true
        },
        "command": "c=\"$HOME/.local/bin/copilot\"; [ -x \"$c\" ] || c=copilot; exec \"$c\" --acp --stdio",
        "modes": {
          "title": "工作模式",
          "unset": "Agent 默认",
          "note": "未选择模式时沿用 Copilot CLI 默认设置。"
        },
        "skillsDir": ".github/skills",
        "configFiles": [
          "${COPILOT_HOME:-~/.copilot}/settings.json",
          "${COPILOT_HOME:-~/.copilot}/providers.json",
          "${COPILOT_PROVIDERS_CONFIG}",
          ".github/copilot/settings.json",
          ".github/copilot/settings.local.json"
        ],
        "setupHint": "请在运行机安装 GitHub Copilot CLI 并运行 copilot login，确认后端能执行 copilot --acp --stdio。"
      }
    ]
  }
}
