<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="vczh-develop-definitions" targetNamespace="https://coda.pub/plugins/vczh">
  <process id="vczh-develop" name="vczh 开发" isExecutable="true" coda:kind="develop" coda:title="vczh 开发">
    <extensionElements>
      <coda:input name="branch" label="起始分支" type="branch" defaultFrom="session.branch" description="从此分支的已提交内容建立独立调查工作树；留空从默认分支开始，原工作区不变" />
      <coda:input name="reviewer" label="代码评审方" type="agent" defaultFrom="session.agent" description="独立的只读评审会话；默认沿用当前 Agent，可选择另一模型" />
      <coda:input name="devices" label="单独验收" type="boolean" default="false" description="检查后安装或准备可运行结果，再由用户验收；CLI 项目按 Project.md 验收" />
      <coda:input name="device" label="验收设备" default="" description="可选的测试机名称；填写后验收阶段独占该设备" />
    </extensionElements>
    <startEvent id="start" />
    <sequenceFlow id="start-to-lane" sourceRef="start" targetRef="lane" />
    <scriptTask id="lane" name="准备调查分支" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="BRANCH" value="=inputs.branch" />
        <coda:output name="root" />
        <coda:output name="branch" />
        <coda:output name="base" />
        <coda:output name="baseCommit" />
        <coda:output name="group" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" lane</script>
    </scriptTask>
    <sequenceFlow id="lane-to-hold" sourceRef="lane" targetRef="hold" />
    <serviceTask id="hold" name="独占项目调查文档" coda:action="hold-group">
      <extensionElements>
        <coda:param name="group" value="=lane.group" />
        <coda:param name="exclusive" value="true" />
        <coda:param name="borrow" value="no" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="hold-to-initialize" sourceRef="hold" targetRef="initialize" />
    <scriptTask id="initialize" name="初始化原文文档" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="GROUP" value="=lane.group" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" initialize</script>
    </scriptTask>
    <sequenceFlow id="initialize-to-prepare" sourceRef="initialize" targetRef="prepare" />
    <userTask id="prepare" name="任务审阅" coda:noteLabel="说明" coda:wake="false">
      <documentation>本次已选择 vczh 开发，由这一条运行负责调查、PR、检查、评审、验收与合并发布。不要再启动 kickoff、simple、vczh 或 pull-request。
工作根目录：{{lane.root}}；调查分支：{{lane.branch}}。这是从所选分支已提交内容建立的独立工作树；原工作区的未提交内容不在这里。
先在此根目录读取 vczh protocol develop，按它加载项目上下文、已启用规范和原生知识库；补全 Project.md 的真实构建与验收命令。
把随本任务到达的用户消息作为最新需求；流程通知不是需求。编码请求先将用户原话逐字写入 TODO_TASK.md，已有任务先保存，不覆盖未完成工作。按 vczh protocol review 审阅 TODO_TASK.md，只补 DETAILS / VERIFICATION / REVIEW COMMENTS，不能提前实现。无法合理解决的歧义用原生提问并写入真实答复，解决后再选「已审阅，开始调查」。本模式的选择已授权在任务审阅后继续调查。
若用户显式要求 ask、review、refine、kb、kb refine 或 investigate report/continue，只执行对应原文命令，保留其停止点；未要求交付时选「本次命令已完成」，不会开 PR。</documentation>
      <extensionElements>
        <coda:choice id="develop" name="已审阅，开始调查" primary="true" note="required" />
        <coda:choice id="command" name="本次命令已完成" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="prepare-to-prepared" sourceRef="prepare" targetRef="prepared" />
    <exclusiveGateway id="prepared" name="是否继续开发" default="prepared-to-investigate" />
    <sequenceFlow id="prepared-to-command-done" sourceRef="prepared" targetRef="command-done">
      <conditionExpression xsi:type="tFormalExpression">=prepare.chose.command</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="prepared-to-investigate" sourceRef="prepared" targetRef="investigate" />
    <endEvent id="command-done" name="原文命令已完成">
      <extensionElements>
        <coda:output name="root" value="=lane.root" />
      </extensionElements>
    </endEvent>
    <userTask id="investigate" name="复现、逐方案实验与择优重放" coda:noteLabel="说明">
      <documentation>在 {{lane.root}}（{{lane.branch}}）执行 vczh protocol investigate 的完整原文。最新请求为 # Repro 加 TODO_TASK.md 全文；保留用户原话、补充内容及 REVIEW COMMENTS。
严格完成：归档旧调查；构造并确认复现测试；实验前记录全部提案；逐个实验、记录 CONFIRMED / DENIED、只提交调查文档并回退实验；全部判断后择优重放；复验与原文自审。多任务逐项提交再做下一项。
读 vczh protocol develop 的交付约定：原文提交与推送检查点保留，调查分支用明确的 refspec 推送；PR 只由本运行创建。把最终代码、Project.md、TODO_TASK.md、TaskLogs、Learning 和 KnowledgeBase 的本次改动提交到 {{lane.branch}}。不得为了完成流程编造偏好、知识或试验记录。
收到纠偏按 # Continue；收到 # Report 只报告并停止。完成交付准备后选「提交检查」，备注约 8 行描述用户可感知的变化与风险。</documentation>
      <extensionElements>
        <coda:choice id="submit" name="提交检查" primary="true" note="required" />
        <coda:choice id="command" name="按原文停止" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="investigate-to-investigated" sourceRef="investigate" targetRef="investigated" />
    <exclusiveGateway id="investigated" name="调查结论" default="investigated-to-push" />
    <sequenceFlow id="investigated-to-command-done" sourceRef="investigated" targetRef="command-done">
      <conditionExpression xsi:type="tFormalExpression">=investigate.chose.command</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="investigated-to-push" sourceRef="investigated" targetRef="push" />
    <scriptTask id="push" name="推送交付提交" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="REPORT" value="=investigate" />
        <coda:output name="head" />
        <coda:output name="baseCommit" />
        <coda:output name="route" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" push</script>
    </scriptTask>
    <sequenceFlow id="push-to-pushed" sourceRef="push" targetRef="pushed" />
    <exclusiveGateway id="pushed" name="已有交付提交" default="pushed-to-checks" />
    <sequenceFlow id="pushed-to-problem" sourceRef="pushed" targetRef="problem">
      <conditionExpression xsi:type="tFormalExpression">=push.route = "fix"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="pushed-to-checks" sourceRef="pushed" targetRef="checks" />
    <serviceTask id="checks" name="项目检查" coda:action="run-workflows" coda:status="项目检查">
      <extensionElements>
        <coda:param name="kind" value="check" />
        <coda:param name="commit" value="=push.head" />
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="checks-failed" name="未通过" attachedToRef="checks">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="checks-failed-to-checks-feedback" sourceRef="checks-failed" targetRef="checks-feedback" />
    <scriptTask id="checks-feedback" name="记录项目检查失败" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="STEP" value="项目检查" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="checks-feedback-to-problem" sourceRef="checks-feedback" targetRef="problem" />
    <sequenceFlow id="checks-to-checks-record" sourceRef="checks" targetRef="checks-record" />
    <scriptTask id="checks-record" name="保存检查证据" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="RESULT" value="=checks" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" checks</script>
    </scriptTask>
    <sequenceFlow id="checks-record-to-pr" sourceRef="checks-record" targetRef="pr" />
    <scriptTask id="pr" name="创建或更新 PR" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="DEVICES" value="=inputs.devices" />
        <coda:output name="url" />
        <coda:output name="head" />
        <coda:output name="base" />
        <coda:output name="task" />
        <coda:output name="evidence" />
        <coda:output name="summary" />
        <coda:output name="review" />
        <coda:output name="device" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" pr</script>
    </scriptTask>
    <sequenceFlow id="pr-to-after-pr" sourceRef="pr" targetRef="after-pr" />
    <exclusiveGateway id="after-pr" name="交付进度" default="after-pr-to-premerge" />
    <sequenceFlow id="after-pr-to-review" sourceRef="after-pr" targetRef="review">
      <conditionExpression xsi:type="tFormalExpression">=pr.review</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="after-pr-to-acceptance" sourceRef="after-pr" targetRef="acceptance">
      <conditionExpression xsi:type="tFormalExpression">=pr.device</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="after-pr-to-premerge" sourceRef="after-pr" targetRef="premerge" />
    <callActivity id="review" name="独立代码评审" calledElement="review-commit">
      <extensionElements>
        <coda:param name="head" value="=pr.head" />
        <coda:param name="base" value="=pr.base" />
        <coda:param name="task" value="=pr.task" />
        <coda:param name="reviewer" value="=inputs.reviewer" />
        <coda:param name="evidence" value="=pr.evidence" />
        <coda:param name="focus" value="请阅读此提交的 Project.md、TODO_TASK.md、.github/TaskLogs/Copilot_Investigate.md 和相关 KnowledgeBase / Learning。核对复现证据、逐方案实验和最终重放；按项目启用的规范审查实际缺陷。复用已有有效检查。此处是实现后的代码评审，不是 vczh 的执行前 review 命令。" />
      </extensionElements>
    </callActivity>
    <boundaryEvent id="review-failed" attachedToRef="review">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="review-failed-to-review-retry" sourceRef="review-failed" targetRef="review-retry" />
    <sequenceFlow id="review-to-review-record" sourceRef="review" targetRef="review-record" />
    <scriptTask id="review-record" name="保存代码评审" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="REVIEW" value="=review" />
        <coda:output name="changes" />
        <coda:output name="incomplete" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" reviewed</script>
    </scriptTask>
    <sequenceFlow id="review-record-to-verdict" sourceRef="review-record" targetRef="verdict" />
    <exclusiveGateway id="verdict" name="代码评审结论" default="verdict-to-pr" />
    <sequenceFlow id="verdict-to-review-retry" sourceRef="verdict" targetRef="review-retry">
      <conditionExpression xsi:type="tFormalExpression">=review-record.incomplete</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="verdict-to-answer" sourceRef="verdict" targetRef="answer">
      <conditionExpression xsi:type="tFormalExpression">=review-record.changes</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="verdict-to-pr" sourceRef="verdict" targetRef="pr" />
    <userTask id="review-retry" name="评审未完成" coda:noteLabel="说明">
      <documentation>当前提交 {{pr.head}} 尚未得到完整代码评审。查看本运行「独立代码评审」及其子流程，处理不可用的评审方或执行错误，再选择重试。评审未完成不能当作通过。
{{review.line}}</documentation>
      <extensionElements>
        <coda:choice id="retry" name="重试评审" primary="true" note="required" />
        <coda:choice id="stop" name="停止交付" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="review-retry-to-retry-choice" sourceRef="review-retry" targetRef="retry-choice" />
    <exclusiveGateway id="retry-choice" name="重试评审" default="retry-choice-to-review" />
    <sequenceFlow id="retry-choice-to-stopped" sourceRef="retry-choice" targetRef="stopped">
      <conditionExpression xsi:type="tFormalExpression">=review-retry.chose.stop</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="retry-choice-to-review" sourceRef="retry-choice" targetRef="review" />
    <userTask id="answer" name="核实代码评审意见" coda:noteLabel="说明">
      <documentation>PR {{pr.url}}，提交 {{pr.head}}：
{{review.report}}
逐条核实可达触发路径与项目规则。成立的问题把原评审意见按 # Continue 追加到 {{lane.root}} 的调查，按原文实验和复验，提交 {{lane.branch}}。后续检查和代码评审针对新的提交重跑。
不采纳的意见须写明依据；理由会原样出现在 PR 与批准卡，由用户决定。不得自动把要求修改当作通过。</documentation>
      <extensionElements>
        <coda:choice id="fixed" name="已修改" primary="true" note="required" />
        <coda:choice id="kept" name="不采纳并说明" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="answer-to-answer-choice" sourceRef="answer" targetRef="answer-choice" />
    <exclusiveGateway id="answer-choice" name="处理方式" default="answer-choice-to-push" />
    <sequenceFlow id="answer-choice-to-kept" sourceRef="answer-choice" targetRef="kept">
      <conditionExpression xsi:type="tFormalExpression">=answer.chose.kept</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="answer-choice-to-push" sourceRef="answer-choice" targetRef="push" />
    <scriptTask id="kept" name="保留未采纳理由" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="ANSWER" value="=answer" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" kept</script>
    </scriptTask>
    <sequenceFlow id="kept-to-pr" sourceRef="kept" targetRef="pr" />
    <subProcess id="acceptance" name="准备结果与用户验收" coda:optional="true">
      <startEvent id="accept-start" />
      <sequenceFlow id="accept-start-to-device-choice" sourceRef="accept-start" targetRef="device-choice" />
      <exclusiveGateway id="device-choice" name="是否占用设备" default="device-choice-to-preview" />
      <sequenceFlow id="device-choice-to-device-resolve" sourceRef="device-choice" targetRef="device-resolve">
        <conditionExpression xsi:type="tFormalExpression">=inputs.device != ""</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="device-choice-to-preview" sourceRef="device-choice" targetRef="preview" />
      <callActivity id="device-resolve" name="解析验收设备" calledElement="resolve-testbed">
        <extensionElements>
          <coda:param name="device" value="=inputs.device" />
        </extensionElements>
      </callActivity>
      <sequenceFlow id="device-resolve-to-device-hold" sourceRef="device-resolve" targetRef="device-hold" />
      <serviceTask id="device-hold" name="占用验收设备" coda:action="hold-group">
        <extensionElements>
          <coda:param name="group" value="=device-resolve.group" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="device-hold-to-preview" sourceRef="device-hold" targetRef="preview" />
      <userTask id="preview" name="准备可验收结果" coda:noteLabel="说明">
        <documentation>验收提交 {{pr.head}}，PR {{pr.url}}。按 Project.md 的验收步骤准备此提交的可运行结果。CLI / C++ 项目提供实际构建的程序路径、复现命令与输出；有客户端时调用项目的 mac-preview-install / ios-preview-install，传此 commit，等安装成功再答复。指定设备为 {{inputs.device}} 时，把 device 传给安装流程。
备注给出用户可复查的运行或安装结果。需要修改则在 {{lane.root}} 按调查协议修正并提交 {{lane.branch}}，选择「已修改」；不能把仅发起安装当作已完成。</documentation>
        <extensionElements>
          <coda:choice id="installed" name="已准备好" primary="true" note="required" />
          <coda:choice id="changed" name="已修改" note="required" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="preview-to-preview-choice" sourceRef="preview" targetRef="preview-choice" />
      <exclusiveGateway id="preview-choice" name="结果已准备" default="preview-choice-to-device" />
      <sequenceFlow id="preview-choice-to-accept-changed" sourceRef="preview-choice" targetRef="accept-changed">
        <conditionExpression xsi:type="tFormalExpression">=preview.chose.changed</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="preview-choice-to-device" sourceRef="preview-choice" targetRef="device" />
      <userTask id="device" name="验收结果" coda:noteLabel="说明" coda:assignee="user">
        <documentation>{{pr.summary}}

提交：{{pr.head}}
准备结果：{{preview.note}}
请按项目验收方式检查结果。未通过时写明意见或附截图，回到同一调查修改；新提交将重新检查、评审和验收。</documentation>
        <extensionElements>
          <coda:choice id="yes" name="通过" primary="true" />
          <coda:choice id="no" name="未通过" note="required" />
        </extensionElements>
      </userTask>
      <sequenceFlow id="device-to-device-result" sourceRef="device" targetRef="device-result" />
      <exclusiveGateway id="device-result" name="验收结论" default="device-result-to-accept-passed" />
      <sequenceFlow id="device-result-to-accept-failed" sourceRef="device-result" targetRef="accept-failed">
        <conditionExpression xsi:type="tFormalExpression">=device.chose.no</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="device-result-to-accept-passed" sourceRef="device-result" targetRef="accept-passed" />
      <endEvent id="accept-changed" name="changed">
        <extensionElements>
          <coda:output name="route" value="changed" />
        </extensionElements>
      </endEvent>
      <endEvent id="accept-failed" name="failed">
        <extensionElements>
          <coda:output name="route" value="failed" />
        </extensionElements>
      </endEvent>
      <endEvent id="accept-passed" name="passed">
        <extensionElements>
          <coda:output name="route" value="passed" />
        </extensionElements>
      </endEvent>
    </subProcess>
    <sequenceFlow id="acceptance-to-accepted" sourceRef="acceptance" targetRef="accepted" />
    <scriptTask id="accepted" name="保存验收结论" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="ROUTE" value="=acceptance.route" />
        <coda:env name="DEVICE" value="=device" />
        <coda:output name="route" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" accepted</script>
    </scriptTask>
    <sequenceFlow id="accepted-to-accepted-choice" sourceRef="accepted" targetRef="accepted-choice" />
    <exclusiveGateway id="accepted-choice" name="后续动作" default="accepted-choice-to-pr" />
    <sequenceFlow id="accepted-choice-to-push" sourceRef="accepted-choice" targetRef="push">
      <conditionExpression xsi:type="tFormalExpression">=accepted.route = "push"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="accepted-choice-to-problem" sourceRef="accepted-choice" targetRef="problem">
      <conditionExpression xsi:type="tFormalExpression">=accepted.route = "fix"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="accepted-choice-to-pr" sourceRef="accepted-choice" targetRef="pr" />
    <serviceTask id="premerge" name="合并前检查" coda:action="run-workflows" coda:status="合并前检查">
      <extensionElements>
        <coda:param name="kind" value="premerge" />
        <coda:param name="commit" value="=pr.head" />
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="premerge-failed" name="未通过" attachedToRef="premerge">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="premerge-failed-to-premerge-feedback" sourceRef="premerge-failed" targetRef="premerge-feedback" />
    <scriptTask id="premerge-feedback" name="记录合并前检查失败" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="STEP" value="合并前检查" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="premerge-feedback-to-problem" sourceRef="premerge-feedback" targetRef="problem" />
    <sequenceFlow id="premerge-to-github-checks" sourceRef="premerge" targetRef="github-checks" />
    <scriptTask id="github-checks" name="等待 GitHub 检查" scriptFormat="bash" coda:timeout="120">
      <extensionElements>
        <coda:env name="URL" value="=pr.url" />
        <coda:output name="passed" />
        <coda:output name="lines" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop-checks.mjs"</script>
    </scriptTask>
    <boundaryEvent id="github-checks-failed" name="未通过" attachedToRef="github-checks">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="github-checks-failed-to-github-checks-feedback" sourceRef="github-checks-failed" targetRef="github-checks-feedback" />
    <scriptTask id="github-checks-feedback" name="记录GitHub 检查读取失败" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="STEP" value="GitHub 检查读取" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="github-checks-feedback-to-problem" sourceRef="github-checks-feedback" targetRef="problem" />
    <sequenceFlow id="github-checks-to-github-choice" sourceRef="github-checks" targetRef="github-choice" />
    <exclusiveGateway id="github-choice" name="GitHub 检查结论" default="github-choice-to-kinds" />
    <sequenceFlow id="github-choice-to-github-feedback" sourceRef="github-choice" targetRef="github-feedback">
      <conditionExpression xsi:type="tFormalExpression">=not(github-checks.passed)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="github-choice-to-kinds" sourceRef="github-choice" targetRef="kinds" />
    <scriptTask id="github-feedback" name="保存 GitHub 检查失败" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="STEP" value="GitHub 检查" />
        <coda:env name="LINES" value="=github-checks.lines" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="github-feedback-to-problem" sourceRef="github-feedback" targetRef="problem" />
    <scriptTask id="problem" name="读取待修复问题" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:output name="text" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" problem</script>
    </scriptTask>
    <sequenceFlow id="problem-to-fix" sourceRef="problem" targetRef="fix" />
    <userTask id="fix" name="继续调查并修复" coda:noteLabel="说明">
      <documentation>{{problem.text}}

在 {{lane.root}} 继续原调查，读取 vczh protocol investigate 与 vczh protocol develop。把反馈原文作为 # Continue 记录，不重新清空已有调查。补齐复现或回归证据、记录并实验提案、择优重放和复验，提交到 {{lane.branch}}。之后由本运行更新同一个 PR，并重跑当前提交的检查、评审与验收。</documentation>
      <extensionElements>
        <coda:choice id="done" name="已修复并提交" primary="true" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="fix-to-push" sourceRef="fix" targetRef="push" />
    <serviceTask id="kinds" name="读取部署与发布选项" coda:action="workflow-kinds">
      <extensionElements>
        <coda:param name="commit" value="=pr.head" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="kinds-to-approval-summary" sourceRef="kinds" targetRef="approval-summary" />
    <scriptTask id="approval-summary" name="核对待批准提交" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="PREMERGE" value="=premerge" />
        <coda:output name="summary" />
        <coda:output name="premerge" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" approval</script>
    </scriptTask>
    <sequenceFlow id="approval-summary-to-approve" sourceRef="approval-summary" targetRef="approve" />
    <userTask id="approve" name="批准合并" coda:noteLabel="说明" coda:assignee="user">
      <documentation>{{approval-summary.summary}}

合并前检查：{{approval-summary.premerge}}
GitHub 检查：{{github-checks.lines}}
PR：{{pr.url}}
按 {{vars.vczh.mergeMethod}} 合并提交 {{pr.head}} 到默认分支 {{lane.base}}。只执行下方选中的部署与发布；此运行创建的远程交付分支将在合并后删除，调查分支和 Markdown 保留。</documentation>
      <extensionElements>
        <coda:choice id="merge" name="合并" primary="true">
          <coda:option id="deploy" name="部署" default="false" coda:shown="=kinds.deploy" />
          <coda:option id="preview" name="发布预览版" default="false" coda:shown="=kinds.preview" />
          <coda:option id="release" name="发布正式版" default="false" coda:shown="=kinds.release" />
          <coda:option id="notify" name="全部完成后通知 Agent" default="true" />
        </coda:choice>
        <coda:choice id="stop" name="暂不合并" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-to-approve-choice" sourceRef="approve" targetRef="approve-choice" />
    <exclusiveGateway id="approve-choice" name="是否合并" default="approve-choice-to-options" />
    <sequenceFlow id="approve-choice-to-stopped" sourceRef="approve-choice" targetRef="stopped">
      <conditionExpression xsi:type="tFormalExpression">=approve.chose.stop</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="approve-choice-to-options" sourceRef="approve-choice" targetRef="options" />
    <endEvent id="stopped" name="停止交付，保留工作" coda:notify="true">
      <extensionElements>
        <coda:output name="pr" value="=pr.url" />
        <coda:output name="root" value="=lane.root" />
      </extensionElements>
    </endEvent>
    <scriptTask id="options" name="记录批准选项" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="APPROVED" value="=approve" />
        <coda:output name="deploy" />
        <coda:output name="release" />
        <coda:output name="releaseKinds" />
        <coda:output name="notify" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" options</script>
    </scriptTask>
    <sequenceFlow id="options-to-merge" sourceRef="options" targetRef="merge" />
    <scriptTask id="merge" name="合并批准的提交" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:env name="METHOD" value="=vars.vczh.mergeMethod" />
        <coda:output name="route" />
        <coda:output name="commit" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" merge</script>
    </scriptTask>
    <sequenceFlow id="merge-to-merged-choice" sourceRef="merge" targetRef="merged-choice" />
    <exclusiveGateway id="merged-choice" name="合并结论" default="merged-choice-to-deploy-choice" />
    <sequenceFlow id="merged-choice-to-problem" sourceRef="merged-choice" targetRef="problem">
      <conditionExpression xsi:type="tFormalExpression">=merge.route = "conflict"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="merged-choice-to-deploy-choice" sourceRef="merged-choice" targetRef="deploy-choice" />
    <exclusiveGateway id="deploy-choice" name="部署" default="deploy-choice-to-release-choice" />
    <sequenceFlow id="deploy-choice-to-deploy" sourceRef="deploy-choice" targetRef="deploy">
      <conditionExpression xsi:type="tFormalExpression">=options.deploy</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="deploy-choice-to-release-choice" sourceRef="deploy-choice" targetRef="release-choice" />
    <serviceTask id="deploy" name="部署合并提交" coda:action="run-workflows" coda:status="部署合并提交">
      <extensionElements>
        <coda:param name="kind" value="deploy" />
        <coda:param name="commit" value="=merge.commit" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="deploy-to-release-choice" sourceRef="deploy" targetRef="release-choice" />
    <exclusiveGateway id="release-choice" name="发布" default="release-choice-to-done" />
    <sequenceFlow id="release-choice-to-notes" sourceRef="release-choice" targetRef="notes">
      <conditionExpression xsi:type="tFormalExpression">=options.release</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="release-choice-to-done" sourceRef="release-choice" targetRef="done" />
    <userTask id="notes" name="编写更新说明" coda:noteLabel="说明">
      <documentation>PR {{pr.url}} 已合并。为选定的发布编写面向用户的 Markdown 更新说明，写变化和已知限制，不超过 2000 字；completed 答复的 note 只放更新说明。</documentation>
    </userTask>
    <sequenceFlow id="notes-to-publishing" sourceRef="notes" targetRef="publishing" />
    <scriptTask id="publishing" name="准备发布参数" scriptFormat="bash" coda:timeout="5" coda:checkout="false">
      <extensionElements>
        <coda:env name="AGENT" value="=notes" />
        <coda:output name="inputs" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/develop.mjs" notes</script>
    </scriptTask>
    <sequenceFlow id="publishing-to-publish" sourceRef="publishing" targetRef="publish" />
    <serviceTask id="publish" name="发布合并提交" coda:action="run-workflows" coda:status="发布合并提交">
      <extensionElements>
        <coda:param name="kind" value="=options.releaseKinds" />
        <coda:param name="commit" value="=merge.commit" />
        <coda:param name="inputs" value="=publishing.inputs" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="publish-to-done" sourceRef="publish" targetRef="done" />
    <endEvent id="done" name="开发与交付完成" coda:notify="=options.notify">
      <extensionElements>
        <coda:output name="pr" value="=pr.url" />
        <coda:output name="commit" value="=merge.commit" />
        <coda:output name="root" value="=lane.root" />
      </extensionElements>
    </endEvent>
  </process>
</definitions>
