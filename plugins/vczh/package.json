{
  "name": "vczh",
  "displayName": "vczh 开发",
  "description": "原文任务审阅、调查与项目知识；在同一开发流程内检查、评审、验收及合并发布。",
  "version": "4.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "contributes": {
    "skills": [
      "skills/vczh"
    ],
    "instructions": "输入框选择 vczh 开发后先读 vczh protocol develop，在该运行工作树完成原文审阅、调查与交付，不另起 kickoff、simple、vczh 或 pull-request。独立原文命令先读 vczh protocol，保留停止点。知识在 Project.md 和 .github；仅加载启用的规范。",
    "commands": [
      {
        "name": "vczh",
        "command": "\"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/cli.mjs\""
      }
    ],
    "panels": [
      {
        "id": "vczh",
        "title": "vczh · 知识与规范",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/panel.mjs\"",
        "maxAge": "PT1M",
        "actions": {
          "browse": {
            "command": "node \"$CODA_PLUGIN_PATH/scripts/panel.mjs\" --browse"
          }
        }
      }
    ],
    "configuration": {
      "title": "vczh 开发",
      "properties": {
        "vczh.mergeMethod": {
          "title": "合并方式",
          "type": "string",
          "enum": [
            "merge",
            "squash",
            "rebase"
          ],
          "default": "merge",
          "description": "默认保留调查的逐任务提交；仅在用户批准后合并到默认分支。"
        }
      }
    }
  },
  "extensionDependencies": [
    "github",
    "review"
  ],
  "categories": [
    "工作流程"
  ]
}
