<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="dickda-refine-definitions" targetNamespace="https://coda.pub/plugins/dickda">
  <process id="dickda-refine" name="dickda Mode · 五层Refine与重构" isExecutable="true" coda:title="dickda Mode · 五层Refine与重构">
    <extensionElements>
      <coda:input name="branch" label="起始分支" type="branch" defaultFrom="session.branch" description="从此分支读取Pending Archive；留空从目标分支开始" />
      <coda:input name="base" label="目标分支" type="string" default="" description="仅允许仓库Default Branch，留空自动读取" />
      <coda:input name="thinker" label="Thinker覆盖" type="agent" description="留空采用插件设置" />
      <coda:input name="architect" label="Architect（Standard）覆盖" type="agent" description="留空采用插件设置（默认 antigravity claude-opus-5-5 high）" />
      <coda:input name="architectSenior" label="Architect（Senior）覆盖" type="agent" description="留空采用插件设置" />
      <coda:input name="builder" label="Builder（Standard）覆盖" type="agent" description="留空采用插件设置" />
      <coda:input name="builderSenior" label="Builder（Senior）覆盖" type="agent" description="留空采用插件设置" />
      <coda:input name="verifier" label="Verifier（Standard）覆盖" type="agent" description="留空采用插件设置" />
      <coda:input name="verifierSenior" label="Verifier（Senior）覆盖" type="agent" description="留空采用插件设置" />
    </extensionElements>

    <startEvent id="start" />
    <sequenceFlow id="start-prepare" sourceRef="start" targetRef="prepare" />

    <scriptTask id="prepare" name="校验Default Branch并确定项目锁" scriptFormat="bash" coda:timeout="5" coda:retry="2">
      <extensionElements>
        <coda:env name="BASE" value="=inputs.base" />
        <coda:output name="group" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" prepare</script>
    </scriptTask>
    <sequenceFlow id="prepare-hold" sourceRef="prepare" targetRef="hold" />

    <serviceTask id="hold" name="独占项目资产锁" coda:action="hold-group">
      <extensionElements>
        <coda:param name="group" value="=prepare.group" />
        <coda:param name="exclusive" value="true" />
        <coda:param name="borrow" value="no" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="hold-collect" sourceRef="hold" targetRef="collect" />

    <scriptTask id="collect" name="读取最早Pending Archive" scriptFormat="bash" coda:timeout="5" coda:retry="2">
      <extensionElements>
        <coda:env name="BRANCH" value="=inputs.branch" />
        <coda:output name="hasArchive" />
        <coda:output name="archive" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" collect</script>
    </scriptTask>
    <sequenceFlow id="collect-gate" sourceRef="collect" targetRef="has-archive" />

    <exclusiveGateway id="has-archive" name="是否存在Pending Archive" default="no-archive" />
    <sequenceFlow id="archive-found" sourceRef="has-archive" targetRef="diagnose">
      <conditionExpression xsi:type="tFormalExpression">=collect.hasArchive = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="no-archive" sourceRef="has-archive" targetRef="empty-done" />

    <endEvent id="empty-done" name="无Pending Archive">
      <extensionElements>
        <coda:output name="summary" value="当前 .dickda/learning/ 下没有未消费的Investigation Archive。" />
      </extensionElements>
    </endEvent>

    <scriptTask id="diagnose" name="Thinker诊断五层落点" scriptFormat="bash" coda:timeout="30" coda:status="Thinker正在分析归档落层">
      <extensionElements>
        <coda:env name="THINKER" value="=inputs.thinker" />
        <coda:output name="needsRefactor" />
        <coda:output name="layers" />
        <coda:output name="summary" />
        <coda:output name="plan" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" diagnose</script>
    </scriptTask>
    <sequenceFlow id="diagnose-decide" sourceRef="diagnose" targetRef="decide" />

    <userTask id="decide" name="决策层拍板重构落层" coda:noteLabel="补充指示（可选）" coda:status="等待Interactor确认五层演进方案">
      <documentation>归档批次：{{collect.archive}}
Thinker五层落点诊断：{{diagnose.layers}}
是否建议结构重构 / 规则硬化：{{if diagnose.needsRefactor = true then "是" else "否（仅文档沉淀）"}}

诊断摘要：
{{diagnose.summary}}

拟执行动作清单：
{{diagnose.plan}}

你是顶层Interactor：涉及对外契约或较大重构时向用户图文说明并确认；小范围 L2 Lint / L3 Verifier 硬化可直接拍板。
- 选「执行五层重构与Refine」：串联执行对应工种提交 L1–L3 改动、精简 L4 旧条文、推送Refine提交，交项目检查与Independent Code Review；
- 选「仅更新 L4 知识经验」：更新知识经验后同样检查、Independent Code Review并提交 PR。用户批准合入Default Branch后完成Archive Consumption；
- 选「暂不处理」：保留原归档退出。</documentation>
      <extensionElements>
        <coda:choice id="refactor" name="执行五层重构与Refine" primary="true" />
        <coda:choice id="prose" name="仅更新 L4 知识经验" />
        <coda:choice id="skip" name="暂不处理" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="decide-parse" sourceRef="decide" targetRef="parse-decision" />

    <scriptTask id="parse-decision" name="解析拍板结果" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="DECISION" value="=decide" />
        <coda:output name="route" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" decide</script>
    </scriptTask>
    <sequenceFlow id="parse-route" sourceRef="parse-decision" targetRef="after-decide" />

    <exclusiveGateway id="after-decide" name="执行路径" default="run-execute" />
    <sequenceFlow id="route-skip" sourceRef="after-decide" targetRef="skipped-done">
      <conditionExpression xsi:type="tFormalExpression">=parse-decision.route = "skip"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="run-execute" sourceRef="after-decide" targetRef="execute" />

    <endEvent id="skipped-done" name="保留归档退出">
      <extensionElements>
        <coda:output name="summary" value="已按决策保留归档暂不消费。" />
      </extensionElements>
    </endEvent>

    <scriptTask id="execute" name="串联提交重构改动、精简 L4 并运行验证" scriptFormat="bash" coda:timeout="60" coda:status="执行层正在串联落地五层Refine">
      <extensionElements>
        <coda:env name="ARCHITECT" value="=inputs.architect" />
        <coda:env name="ARCHITECT_SENIOR" value="=inputs.architectSenior" />
        <coda:env name="BUILDER" value="=inputs.builder" />
        <coda:env name="BUILDER_SENIOR" value="=inputs.builderSenior" />
        <coda:env name="VERIFIER" value="=inputs.verifier" />
        <coda:env name="VERIFIER_SENIOR" value="=inputs.verifierSenior" />
        <coda:output name="head" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" execute</script>
    </scriptTask>
    <boundaryEvent id="execute-error" attachedToRef="execute"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="execute-to-repair" sourceRef="execute-error" targetRef="repair" />
    <sequenceFlow id="execute-to-checks" sourceRef="execute" targetRef="checks" />

    <serviceTask id="checks" name="运行Refine提交的项目检查" coda:action="run-workflows">
      <extensionElements>
        <coda:param name="hook" value="check" />
        <coda:param name="commit" value="=if repair.head = null then execute.head else repair.head" />
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="checks-error" attachedToRef="checks"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="checks-to-failure" sourceRef="checks-error" targetRef="checks-failed" />
    <scriptTask id="checks-failed" name="记录项目检查失败" scriptFormat="bash" coda:checkout="false">
      <extensionElements>
        <coda:env name="STEP" value="项目检查" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="checks-to-repair" sourceRef="checks-failed" targetRef="repair" />

    <scriptTask id="repair" name="从Refine分支最新提交修复并验证" scriptFormat="bash" coda:timeout="60">
      <extensionElements>
        <coda:env name="ARCHITECT" value="=inputs.architect" />
        <coda:env name="ARCHITECT_SENIOR" value="=inputs.architectSenior" />
        <coda:env name="BUILDER" value="=inputs.builder" />
        <coda:env name="BUILDER_SENIOR" value="=inputs.builderSenior" />
        <coda:env name="VERIFIER" value="=inputs.verifier" />
        <coda:env name="VERIFIER_SENIOR" value="=inputs.verifierSenior" />
        <coda:output name="head" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" repair</script>
    </scriptTask>
    <sequenceFlow id="repair-to-checks" sourceRef="repair" targetRef="checks" />
    <boundaryEvent id="repair-error" attachedToRef="repair"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="repair-error-to-status" sourceRef="repair-error" targetRef="repair-status" />
    <scriptTask id="repair-status" name="读取修复阻塞原因" scriptFormat="bash" coda:checkout="false">
      <extensionElements>
        <coda:output name="reason" />
        <coda:output name="head" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" repair-status</script>
    </scriptTask>
    <sequenceFlow id="status-to-help" sourceRef="repair-status" targetRef="repair-help" />

    <userTask id="repair-help" name="Refine修复受阻" coda:noteLabel="继续修复的指示或停止原因">
      <documentation>归档 {{collect.archive}}，Refine提交 {{repair-status.head}}。修复记录见 coda://workflow-runs/{{run.id}}。
{{repair-status.reason}}</documentation>
      <extensionElements>
        <coda:choice id="continue" name="指示继续修复" primary="true" note="required" />
        <coda:choice id="stop" name="停止并保留原归档退出" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="help-to-choice" sourceRef="repair-help" targetRef="help-choice" />
    <exclusiveGateway id="help-choice" default="help-stop" />
    <sequenceFlow id="help-continue" sourceRef="help-choice" targetRef="continue-repair">
      <conditionExpression xsi:type="tFormalExpression">=repair-help.chose.continue</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="help-stop" sourceRef="help-choice" targetRef="record-stop" />
    <scriptTask id="continue-repair" name="记录Interactor修复指示" scriptFormat="bash" coda:checkout="false">
      <extensionElements><coda:env name="NOTE" value="=repair-help.note" /></extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" continue-repair</script>
    </scriptTask>
    <sequenceFlow id="continue-to-repair" sourceRef="continue-repair" targetRef="repair" />

    <sequenceFlow id="checks-to-review" sourceRef="checks" targetRef="prepare-review" />
    <scriptTask id="prepare-review" name="准备Independent Code Review与复评基线" scriptFormat="bash" coda:checkout="false">
      <extensionElements>
        <coda:env name="VERIFIER" value="=inputs.verifier" />
        <coda:env name="VERIFIER_SENIOR" value="=inputs.verifierSenior" />
        <coda:env name="RUNS" value="=checks.runs" />
        <coda:output name="base" />
        <coda:output name="head" />
        <coda:output name="previous" />
        <coda:output name="tier" />
        <coda:output name="task" />
        <coda:output name="evidence" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" prepare-review</script>
    </scriptTask>
    <sequenceFlow id="prepare-to-review" sourceRef="prepare-review" targetRef="review-commit" />
    <callActivity id="review-commit" name="Independent Code ReviewRefine提交" calledElement="review-commit">
      <extensionElements>
        <coda:param name="base" value="=prepare-review.base" />
        <coda:param name="head" value="=prepare-review.head" />
        <coda:param name="previous" value="=prepare-review.previous" />
        <coda:param name="reviewer" value='={r: if prepare-review.tier = "senior"
          then (if inputs.verifierSenior != null then inputs.verifierSenior else vars.dickda.verifierSenior)
          else (if inputs.verifier != null then inputs.verifier else vars.dickda.verifierStandard), reviewer: if r.agent = "antigravity" then context put(r, "mode", "full") else r}.reviewer' />
        <coda:param name="task" value="=prepare-review.task" />
        <coda:param name="evidence" value="=prepare-review.evidence" />
      </extensionElements>
    </callActivity>
    <boundaryEvent id="review-error" attachedToRef="review-commit"><errorEventDefinition /></boundaryEvent>
    <sequenceFlow id="review-error-to-retry" sourceRef="review-error" targetRef="review-retry" />
    <sequenceFlow id="review-to-verdict" sourceRef="review-commit" targetRef="reviewed" />
    <scriptTask id="reviewed" name="核对审查结论与提交" scriptFormat="bash" coda:checkout="false">
      <extensionElements>
        <coda:env name="REVIEW" value="=review-commit" />
        <coda:env name="PREVIOUS" value="=prepare-review.previous" />
        <coda:output name="route" />
        <coda:output name="reason" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" reviewed</script>
    </scriptTask>
    <sequenceFlow id="verdict-to-gate" sourceRef="reviewed" targetRef="review-gate" />
    <exclusiveGateway id="review-gate" default="review-incomplete" />
    <sequenceFlow id="review-pass" sourceRef="review-gate" targetRef="deliver">
      <conditionExpression xsi:type="tFormalExpression">=reviewed.route = "pr"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="review-changes" sourceRef="review-gate" targetRef="adjudicate">
      <conditionExpression xsi:type="tFormalExpression">=reviewed.route = "changes"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="review-incomplete" sourceRef="review-gate" targetRef="review-retry" />

    <userTask id="review-retry" name="Independent Code Review未完成">
      <documentation>提交 {{prepare-review.head}} 尚无有效的Independent Code Review结论。请查看本次 review-commit 的运行记录。
{{reviewed.reason}}</documentation>
      <extensionElements>
        <coda:choice id="retry" name="重试Independent Code Review" primary="true" />
        <coda:choice id="stop" name="停止并保留归档" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="retry-to-choice" sourceRef="review-retry" targetRef="retry-choice" />
    <exclusiveGateway id="retry-choice" default="retry-stop" />
    <sequenceFlow id="retry-review" sourceRef="retry-choice" targetRef="review-commit">
      <conditionExpression xsi:type="tFormalExpression">=review-retry.chose.retry</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="retry-stop" sourceRef="retry-choice" targetRef="record-stop" />

    <userTask id="adjudicate" name="Interactor裁决Independent Code Review意见" coda:noteLabel="修复指示或不采纳的客观依据">
      <documentation>Refine提交 {{prepare-review.head}}
{{reviewed.reason}}

不采纳的依据将与原审查结论一并写入 PR 和用户批准卡。</documentation>
      <extensionElements>
        <coda:choice id="repair" name="派工程师按审查意见修改" primary="true" />
        <coda:choice id="kept" name="不采纳并写明客观依据" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="adjudicate-to-decision" sourceRef="adjudicate" targetRef="review-decision" />
    <scriptTask id="review-decision" name="记录审查裁决" scriptFormat="bash" coda:checkout="false">
      <extensionElements>
        <coda:env name="DECISION" value="=adjudicate" />
        <coda:output name="route" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" review-decision</script>
    </scriptTask>
    <sequenceFlow id="decision-to-choice" sourceRef="review-decision" targetRef="review-choice" />
    <exclusiveGateway id="review-choice" default="decision-repair" />
    <sequenceFlow id="decision-kept" sourceRef="review-choice" targetRef="deliver">
      <conditionExpression xsi:type="tFormalExpression">=review-decision.route = "kept"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="decision-repair" sourceRef="review-choice" targetRef="repair" />

    <scriptTask id="deliver" name="创建或更新Refine交付 PR" scriptFormat="bash" coda:timeout="5" coda:retry="2">
      <extensionElements>
        <coda:output name="commit" />
        <coda:output name="pr" />
        <coda:output name="summary" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" deliver</script>
    </scriptTask>
    <sequenceFlow id="deliver-to-premerge" sourceRef="deliver" targetRef="premerge" />

    <serviceTask id="premerge" name="Premerge Checks（hook=premerge）" coda:action="run-workflows" coda:status="运行Premerge Checks">
      <extensionElements>
        <coda:param name="hook" value="premerge" />
        <coda:param name="commit" value="=deliver.commit" />
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="premerge-err" attachedToRef="premerge">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="premerge-err-flow" sourceRef="premerge-err" targetRef="premerge-failed" />

    <scriptTask id="premerge-failed" name="记录Premerge Checks失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="STEP" value="Premerge Checks" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="premerge-to-repair" sourceRef="premerge-failed" targetRef="repair" />
    <sequenceFlow id="premerge-to-gh" sourceRef="premerge" targetRef="github-checks" />

    <scriptTask id="github-checks" name="等待 GitHub 检查" scriptFormat="bash" coda:checkout="false" coda:timeout="60" coda:status="等待 GitHub 检查">
      <extensionElements>
        <coda:env name="URL" value="=deliver.pr" />
        <coda:env name="EVERY" value="10" />
        <coda:output name="passed" />
        <coda:output name="lines" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/checks.mjs"</script>
    </scriptTask>
    <boundaryEvent id="gh-err" attachedToRef="github-checks">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="gh-err-flow" sourceRef="gh-err" targetRef="gh-failed" />
    <sequenceFlow id="gh-checked" sourceRef="github-checks" targetRef="gh-gate" />

    <exclusiveGateway id="gh-gate" name="GitHub 检查是否通过" default="gh-ok" />
    <sequenceFlow id="gh-not-passed" sourceRef="gh-gate" targetRef="gh-failed">
      <conditionExpression xsi:type="tFormalExpression">=not(github-checks.passed)</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="gh-ok" sourceRef="gh-gate" targetRef="joiners" />

    <scriptTask id="gh-failed" name="记录 GitHub 检查失败" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="STEP" value="GitHub 检查" />
        <coda:env name="LINES" value="=github-checks.lines" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" failed</script>
    </scriptTask>
    <sequenceFlow id="gh-to-repair" sourceRef="gh-failed" targetRef="repair" />

    <serviceTask id="joiners" name="读取合并后挂点流程" coda:action="hook-joiners">
      <extensionElements>
        <coda:param name="hook" value="merged" />
        <coda:param name="commit" value="=deliver.commit" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="joiners-to-check" sourceRef="joiners" targetRef="approval-check" />

    <scriptTask id="approval-check" name="核对待批准提交" scriptFormat="bash" coda:timeout="5">
      <extensionElements>
        <coda:output name="summary" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" approval-check</script>
    </scriptTask>
    <sequenceFlow id="check-to-approve" sourceRef="approval-check" targetRef="approve" />

    <userTask id="approve" name="批准合并五层Refine PR" coda:assignee="user" coda:status="等待用户裁决并批准合并">
      <documentation>{{approval-check.summary}}

- **GitHub 检查**：{{if github-checks.lines = null or github-checks.lines = "" then "无额外项" else github-checks.lines}}
- **PR**：{{deliver.pr}}</documentation>
      <extensionElements>
        <coda:choice id="merge" name="合并" primary="true">
          <coda:optionList value="=joiners.list" />
          <coda:option id="notify" name="全部完成后通知Interactor" default="true" />
        </coda:choice>
        <coda:choice id="stop" name="暂不合并" note="required" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="approve-to-gate" sourceRef="approve" targetRef="approve-gate" />

    <exclusiveGateway id="approve-gate" name="是否批准合并" default="approve-stop" />
    <sequenceFlow id="approved-flow" sourceRef="approve-gate" targetRef="approval-parse">
      <conditionExpression xsi:type="tFormalExpression">=approve.chose.merge</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="approve-stop" sourceRef="approve-gate" targetRef="record-stop" />

    <scriptTask id="record-stop" name="记录停止原因与保留的Refine分支" scriptFormat="bash" coda:checkout="false">
      <extensionElements>
        <coda:env name="REASON" value="=if approve.chose.stop then approve.note else if repair-help.chose.stop then repair-help.note else review-retry.note" />
        <coda:output name="reason" />
        <coda:output name="branch" />
        <coda:output name="pr" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" stopped</script>
    </scriptTask>
    <sequenceFlow id="recorded-stop" sourceRef="record-stop" targetRef="stopped" />
    <endEvent id="stopped" name="停止Refine，保留归档与交付分支" coda:notify="true">
      <extensionElements>
        <coda:output name="reason" value="=record-stop.reason" />
        <coda:output name="pr" value="=record-stop.pr" />
        <coda:output name="branch" value="=record-stop.branch" />
      </extensionElements>
    </endEvent>

    <scriptTask id="approval-parse" name="解析合并后选项" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="APPROVED" value="=approve" />
        <coda:env name="JOINERS" value="=joiners.list" />
        <coda:output name="notify" />
        <coda:output name="only" />
        <coda:output name="inputs" />
        <coda:output name="missing" />
        <coda:output name="asks" />
        <coda:output name="needs" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/approval.mjs" parse</script>
    </scriptTask>
    <sequenceFlow id="parse-to-merge" sourceRef="approval-parse" targetRef="merge" />

    <scriptTask id="merge" name="合并批准的提交" scriptFormat="bash" coda:timeout="10" coda:status="合并中">
      <extensionElements>
        <coda:output name="route" />
        <coda:output name="commit" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/refine.mjs" merge</script>
    </scriptTask>
    <sequenceFlow id="merge-to-gate" sourceRef="merge" targetRef="merge-gate" />

    <exclusiveGateway id="merge-gate" name="合并是否成功" default="merged-ok" />
    <sequenceFlow id="merge-conflict" sourceRef="merge-gate" targetRef="repair">
      <conditionExpression xsi:type="tFormalExpression">=merge.route = "conflict"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="merged-ok" sourceRef="merge-gate" targetRef="after-merge" />

    <exclusiveGateway id="after-merge" name="是否运行合并后流程" default="to-fill-gate" />
    <sequenceFlow id="no-merged-flows" sourceRef="after-merge" targetRef="done-none">
      <conditionExpression xsi:type="tFormalExpression">=approval-parse.only = "[]"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="to-fill-gate" sourceRef="after-merge" targetRef="fill-gate" />

    <exclusiveGateway id="fill-gate" name="是否缺合并后流程输入" default="fill-skip" />
    <sequenceFlow id="fill-needed" sourceRef="fill-gate" targetRef="fill">
      <conditionExpression xsi:type="tFormalExpression">=approval-parse.missing != ""</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fill-skip" sourceRef="fill-gate" targetRef="merged-inputs" />

    <userTask id="fill" name="补写合并后流程参数" coda:noteLabel="参数内容">
      <documentation>用户勾选的合并后流程需要填写参数：
{{split(approval-parse.asks, "\n")[loopCounter]}}
PR {{deliver.pr}} 已合并（{{merge.commit}}）。请在备注填写对应面向用户的说明（如更新日志）。</documentation>
      <extensionElements>
        <coda:choice id="done" name="已填写" primary="true" note="required" />
        <coda:choice id="skip" name="跳过该项流程" />
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="true" coda:inputCollection='=split(approval-parse.missing, ",")' coda:inputElement="item" />
    </userTask>
    <sequenceFlow id="filled-to-inputs" sourceRef="fill" targetRef="merged-inputs" />

    <scriptTask id="merged-inputs" name="整理合并后流程参数" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="INPUTS" value="=approval-parse.inputs" />
        <coda:env name="MISSING" value="=approval-parse.missing" />
        <coda:env name="ASKS" value="=approval-parse.asks" />
        <coda:env name="FILLS" value="=fill" />
        <coda:env name="NEEDS" value="=approval-parse.needs" />
        <coda:env name="ONLY" value="=approval-parse.only" />
        <coda:output name="inputs" />
        <coda:output name="only" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/approval.mjs" inputs</script>
    </scriptTask>
    <sequenceFlow id="inputs-to-left" sourceRef="merged-inputs" targetRef="left-gate" />

    <exclusiveGateway id="left-gate" default="run-merged" />
    <sequenceFlow id="left-empty" sourceRef="left-gate" targetRef="done-none">
      <conditionExpression xsi:type="tFormalExpression">=merged-inputs.only = "[]"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="run-merged" sourceRef="left-gate" targetRef="merged-flows" />

    <serviceTask id="merged-flows" name="运行合并后流程" coda:action="run-workflows" coda:status="运行合并后流程">
      <extensionElements>
        <coda:param name="hook" value="merged" />
        <coda:param name="only" value="=merged-inputs.only" />
        <coda:param name="commit" value="=merge.commit" />
        <coda:param name="inputs" value="=merged-inputs.inputs" />
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="merged-to-summary" sourceRef="merged-flows" targetRef="merged-summary" />

    <scriptTask id="merged-summary" name="汇总合并后结果" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:env name="RUNS" value="=merged-flows.runs" />
        <coda:env name="JOINERS" value="=joiners.list" />
        <coda:output name="line" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/approval.mjs" ran</script>
    </scriptTask>
    <sequenceFlow id="summary-to-done" sourceRef="merged-summary" targetRef="done" />

    <endEvent id="done-none" name="Refine已合入Default Branch" coda:notify="=approval-parse.notify">
      <extensionElements>
        <coda:output name="pr" value="=deliver.pr" />
        <coda:output name="commit" value="=merge.commit" />
        <coda:output name="consumed" value="=collect.archive" />
        <coda:output name="summary" value="已在Default BranchArchive Consumption {{collect.archive}}。" />
        <coda:output name="afterMerge" value="没有运行合并后的流程" />
      </extensionElements>
    </endEvent>

    <endEvent id="done" name="Refine及合并后流程完成" coda:notify="=approval-parse.notify">
      <extensionElements>
        <coda:output name="pr" value="=deliver.pr" />
        <coda:output name="commit" value="=merge.commit" />
        <coda:output name="consumed" value="=collect.archive" />
        <coda:output name="summary" value="已在Default BranchArchive Consumption {{collect.archive}}。" />
        <coda:output name="afterMerge" value="=merged-summary.line" />
      </extensionElements>
    </endEvent>
  </process>
</definitions>
