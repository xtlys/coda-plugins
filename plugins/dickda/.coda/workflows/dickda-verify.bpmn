<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:coda="https://coda.pub/schema/bpmn/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="dickda-verify-definitions" targetNamespace="https://coda.pub/plugins/dickda">
  <process id="dickda-verify" name="dickda Mode · Dual-Track Verification" isExecutable="true" coda:title="dickda Mode · Dual-Track Verification">
    <extensionElements>
      <coda:input name="commit" label="待验证提交" type="string" default="" description="显式指定待验证的提交 SHA；留空使用本次运行的提交 (run.commit)" />
      <coda:input name="branch" label="待拉取分支" type="string" default="" description="可选：若待验证提交在远端Requirement Branch上，先从 origin 拉取该分支" />
      <coda:input name="tier" label="验证级别" type="string" default="standard" description="Standard（standard）或 Senior（senior）" />
      <coda:input name="verifier" label="Verifier（Standard）覆盖" type="agent" />
      <coda:input name="verifierSenior" label="Verifier（Senior）覆盖" type="agent" />
      <coda:input name="ui" label="启用 Agent / UI 实证验收" type="boolean" default="true" description="是否调用Verifier运行 .dickda/verifiers 中的实证与 UI 规约" />
      <coda:input name="device" label="验收设备" type="string" default="" description="启用 UI 且填写设备时，在Dual-Track Verification前用 testbed 预检，仅在执行 Agent/UI 规约时占用" />
      <coda:input name="task" label="任务说明" type="string" default="" description="本次需求与验收背景摘要" />
    </extensionElements>

    <startEvent id="start" />
    <sequenceFlow id="start-preflight" sourceRef="start" targetRef="preflight-gate" />
    <exclusiveGateway id="preflight-gate" name="是否预检验收设备" default="skip-preflight" />
    <sequenceFlow id="preflight-needed" sourceRef="preflight-gate" targetRef="device-resolve">
      <conditionExpression xsi:type="tFormalExpression">=inputs.ui = true and inputs.device != ""</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="skip-preflight" sourceRef="preflight-gate" targetRef="preflight-done" />

    <callActivity id="device-resolve" name="通过 testbed 预检验收设备" calledElement="resolve-testbed">
      <extensionElements>
        <coda:param name="device" value="=inputs.device" />
      </extensionElements>
    </callActivity>
    <sequenceFlow id="device-resolved" sourceRef="device-resolve" targetRef="preflight-done" />

    <exclusiveGateway id="preflight-done" />
    <sequenceFlow id="preflight-to-fork" sourceRef="preflight-done" targetRef="tracks-fork" />
    <parallelGateway id="tracks-fork" name="并行Dual-Track Verification" />
    <sequenceFlow id="fork-to-code" sourceRef="tracks-fork" targetRef="code-verify" />
    <sequenceFlow id="fork-to-agent-gate" sourceRef="tracks-fork" targetRef="agent-gate" />

    <scriptTask id="code-verify" name="Code Track · Lint &amp; Verification" scriptFormat="bash" coda:timeout="30" coda:status="运行 L2 Lint 与 L3 Code Verifier">
      <extensionElements>
        <coda:env name="COMMIT" value="=inputs.commit" />
        <coda:env name="RUN_COMMIT" value="=run.commit" />
        <coda:env name="BRANCH" value="=inputs.branch" />
        <coda:output name="commit" />
        <coda:output name="passed" />
        <coda:output name="summary" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/verify.mjs" code</script>
    </scriptTask>
    <sequenceFlow id="code-to-join" sourceRef="code-verify" targetRef="tracks-join" />

    <exclusiveGateway id="agent-gate" name="是否运行 Agent / UI 实证" default="agent-skip" />
    <sequenceFlow id="agent-needed" sourceRef="agent-gate" targetRef="agent-sub">
      <conditionExpression xsi:type="tFormalExpression">=inputs.ui = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="agent-skip" sourceRef="agent-gate" targetRef="tracks-join" />

    <subProcess id="agent-sub" name="Agent/UI Track · 独立黑盒与 UI 实证">
      <startEvent id="agent-sub-start" />
      <sequenceFlow id="sub-start-to-plan" sourceRef="agent-sub-start" targetRef="agent-plan" />
      <scriptTask id="agent-plan" name="检查目标提交的 Agent/UI 规约" scriptFormat="bash" coda:timeout="5">
        <extensionElements>
          <coda:env name="COMMIT" value="=inputs.commit" />
          <coda:env name="RUN_COMMIT" value="=run.commit" />
          <coda:env name="BRANCH" value="=inputs.branch" />
          <coda:output name="needed" />
          <coda:output name="commit" />
        </extensionElements>
        <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/verify.mjs" agent-plan</script>
      </scriptTask>
      <sequenceFlow id="plan-to-specs" sourceRef="agent-plan" targetRef="specs-gate" />
      <exclusiveGateway id="specs-gate" name="是否有 Agent/UI 规约" default="no-specs" />
      <sequenceFlow id="have-specs" sourceRef="specs-gate" targetRef="device-gate">
        <conditionExpression xsi:type="tFormalExpression">=agent-plan.needed = true</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="no-specs" sourceRef="specs-gate" targetRef="agent-sub-end" />

      <exclusiveGateway id="device-gate" name="是否占用测试设备" default="device-skip" />
      <sequenceFlow id="device-needed" sourceRef="device-gate" targetRef="device-hold">
        <conditionExpression xsi:type="tFormalExpression">=inputs.device != ""</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="device-skip" sourceRef="device-gate" targetRef="agent-verify" />

      <serviceTask id="device-hold" name="独占验收设备" coda:action="hold-group" coda:status="等待设备 {{inputs.device}}">
        <extensionElements>
          <coda:param name="group" value="=device-resolve.group" />
          <coda:param name="capacity" value="1" />
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="device-held" sourceRef="device-hold" targetRef="agent-verify" />

      <scriptTask id="agent-verify" name="执行实证与 UI 验收" scriptFormat="bash" coda:timeout="60" coda:status="Verifier正在实证验收">
        <extensionElements>
          <coda:env name="TIER" value="=inputs.tier" />
          <coda:env name="VERIFIER" value="=inputs.verifier" />
          <coda:env name="VERIFIER_SENIOR" value="=inputs.verifierSenior" />
          <coda:env name="COMMIT" value="=agent-plan.commit" />
          <coda:env name="BRANCH" value="=inputs.branch" />
          <coda:env name="DEVICE" value="=inputs.device" />
          <coda:env name="TASK" value="=inputs.task" />
          <coda:output name="commit" />
          <coda:output name="passed" />
          <coda:output name="summary" />
        </extensionElements>
        <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/verify.mjs" agent</script>
      </scriptTask>
      <sequenceFlow id="agent-verify-done" sourceRef="agent-verify" targetRef="agent-sub-end" />
      <endEvent id="agent-sub-end" />
    </subProcess>
    <sequenceFlow id="agent-sub-to-join" sourceRef="agent-sub" targetRef="tracks-join" />

    <parallelGateway id="tracks-join" name="汇合Dual-Track Verification结论" />
    <sequenceFlow id="join-to-summary" sourceRef="tracks-join" targetRef="verify-summary" />

    <scriptTask id="verify-summary" name="汇总Dual-Track Verification报告" scriptFormat="bash" coda:checkout="false" coda:timeout="5">
      <extensionElements>
        <coda:output name="commit" />
        <coda:output name="passed" />
        <coda:output name="report" />
        <coda:output name="evidence" />
        <coda:output name="findings" />
      </extensionElements>
      <script>"$CODA_NODE" "$CODA_PLUGIN_PATH/scripts/verify.mjs" summary</script>
    </scriptTask>
    <sequenceFlow id="summary-to-end" sourceRef="verify-summary" targetRef="done" />

    <endEvent id="done" name="Dual-Track Verification结束">
      <extensionElements>
        <coda:output name="commit" value="=verify-summary.commit" />
        <coda:output name="passed" value="=verify-summary.passed" />
        <coda:output name="report" value="=verify-summary.report" />
        <coda:output name="evidence" value="=verify-summary.evidence" />
        <coda:output name="findings" value="=verify-summary.findings" />
      </extensionElements>
    </endEvent>
  </process>
</definitions>
