{
  "name": "opencode",
  "displayName": "OpenCode",
  "description": "OpenCode Agent：Coda 的入口在运行机的 opencode acp 与 Coda 之间转发，并把会话指令放进原生会话的第一轮。",
  "version": "1.1.1",
  "contributes": {
    "agents": [
      {
        "id": "opencode",
        "displayName": "OpenCode",
        "icon": {
          "light": "icons/opencode-light.pdf",
          "dark": "icons/opencode-dark.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "unset": "Agent 默认",
          "note": "工具权限沿用运行机的 OpenCode 配置。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${OPENCODE_CONFIG}",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/opencode.json",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/opencode.jsonc",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/config.json",
          "opencode.json",
          "opencode.jsonc"
        ],
        "setupHint": "请在运行机安装并登录 OpenCode，确认后端能执行 opencode acp。"
      }
    ],
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  }
}
