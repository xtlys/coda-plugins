{
  "name": "echo",
  "displayName": "回声（模板）",
  "description": "最小的 Agent 插件模板：手写 ACP 的回声 Agent，没有依赖；提示词以 wait 开头时演示等待项登记与自主轮次。",
  "version": "1.1.0",
  "contributes": {
    "agents": [
      {
        "id": "echo",
        "displayName": "回声",
        "icon": {
          "light": "icons/echo.pdf",
          "template": true
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "setupHint": "回声 Agent 不需要登录，也不联网；起不来时看运行机上 Coda 后端的 Node。"
      }
    ]
  }
}
